# Vasool Configuration Template
# Copy this file to .env and fill in your API credentials.

# Vectorize Hindsight API Key (https://hindsight.vectorize.io)
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Groq Cloud API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Hindsight Memory Bank Identifier
HINDSIGHT_BANK_ID=vasool-demo

# Optional: Custom Hindsight Base URL (defaults to https://api.hindsight.vectorize.io)
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
